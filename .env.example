# Copy to .env and fill in. .env is gitignored; .env.example is committed.
#
# With a key set, the pipeline makes real OpenAI calls through LangChain.
# With it blank or absent, the pipeline falls back to the recorded runs in
# cached/ and prints that it did so — nothing silently pretends to be live.

OPENAI_API_KEY=

# Optional. Defaults shown.
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0

# Optional: replay recorded latencies when falling back to cached runs.
# 0 = instant (default), 1 = real time, 4 = four times faster.
CACHE_PLAYBACK_SPEED=0
